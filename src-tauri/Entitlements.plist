<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Release builds use the hardened runtime. Without this entitlement macOS never shows the
       microphone prompt and silently delivers zeroed audio (NSMicrophoneUsageDescription in
       Info.plist is the prompt text; this is the permission to ask at all). -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
</dict>
</plist>
